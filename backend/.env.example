# CropX Backend Environment Variables Template

PROJECT_NAME="CropX AI Backend"
ENVIRONMENT="development"

# JWT Authentication Secret Key (Required for production, min 32 chars)
# Generate a new random secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Storage
DATABASE_URL="sqlite:///./cropx.db"
UPLOADS_DIR="uploads"

# Weather API (Optional: Open-Meteo free public API is used by default without requiring an API key)
# If using OpenWeatherMap, configure your rotated key here:
OPENWEATHER_API_KEY=""

# Allowed Cross-Origin Resource Sharing (CORS) Origins
CORS_ORIGINS=["http://localhost:4028","http://localhost:3000","http://127.0.0.1:4028"]

# Optional Social OAuth Credentials (for Google & Facebook Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
